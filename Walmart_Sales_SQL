--PART 4--
Time-Based Sales Analysis
--Topic 1: Sales by Year
select * from walmart_sales;

select 
extract(year from sale_date) as years,
sum (weekly_sales) as total
from walmart_sales
group by extract(year from sale_date)
order by years asc;

select 
extract(month from sale_date) as months,
sum(weekly_sales) as total_sales
from walmart_sales
group by extract(month from sale_date)
order by months asc;


select 
extract(year from sale_date) as years,
extract(month from sale_date) as months,
sum(weekly_sales) as total_sales
from walmart_sales
group by extract(month from sale_date),
extract(year from sale_date)
order by years, months asc;

select 
extract ( year from sale_date) as years,
extract (month from sale_date) as months,
sum( weekly_sales) as highest_sales
from walmart_sales
group by extract (year from sale_date),
extract (month from sale_date) 
order by years,months asc;


--very important cte
WITH monthly_sales AS (
    SELECT
        EXTRACT(YEAR FROM sale_date) AS years,
        EXTRACT(MONTH FROM sale_date) AS months,
        SUM(weekly_sales) AS total_sales
    FROM walmart_sales
    GROUP BY
        EXTRACT(YEAR FROM sale_date),
        EXTRACT(MONTH FROM sale_date)
),
ranked_sales AS (
    SELECT
        years,
        months,
        total_sales,
        RANK() OVER (
            PARTITION BY years
            ORDER BY total_sales DESC
        ) AS sales_rank
    FROM monthly_sales
)
SELECT
    years,
    months,
    total_sales
FROM ranked_sales
WHERE sales_rank = 1
ORDER BY years;

select 
extract (year from sale_date) as yearss,
extract (month from sale_date) as months,
sum(weekly_sales) as total_sales
from walmart_sales
group by extract (year from sale_date),
extract (month from sale_date)
order by yearss, months asc;



