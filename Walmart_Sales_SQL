-- Check for exact duplicate records across all 8 columns
SELECT
    store_id,
    sale_date,
    weekly_sales,
    holiday_flag,
    temperature,
    fuel_price,
    cpi,
    unemployment,
    COUNT(*) AS duplicate_count
FROM walmart_sales
GROUP BY
    store_id,
    sale_date,
    weekly_sales,
    holiday_flag,
    temperature,
    fuel_price,
    cpi,
    unemployment
HAVING COUNT(*) > 1;

