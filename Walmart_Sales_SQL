SELECT
    store_id,
    EXTRACT(YEAR FROM sale_date) AS years,
    SUM(weekly_sales) AS total_sales,
    RANK() OVER (
        PARTITION BY EXTRACT(YEAR FROM sale_date)
        ORDER BY SUM(weekly_sales) DESC
    ) AS sales_rank
FROM walmart_sales
GROUP BY
    store_id,
    EXTRACT(YEAR FROM sale_date)
ORDER BY
    years,
    sales_rank;

